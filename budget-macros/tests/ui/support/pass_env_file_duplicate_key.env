# Fixture for the budget-macros UI test `pass_env_file_duplicate_key.rs`.
# Do not remove: that fixture reads this file through the macro-generated
# env_file lookup. Every key here appears twice on purpose — the parser walks
# the file line by line and returns on the first line whose left-hand side
# matches, so the *first* definition is the effective one and the rest are
# dead text. `cargo budget-report --derive-limits` appends or rewrites lines,
# so duplicates are a real state a generated limits file can reach; this file
# pins which side wins.
#
# FIRST_WINS_LIMIT is satisfiable first and unsatisfiable second: the case
# that reads it passes only under first-match semantics.
FIRST_WINS_LIMIT=1000000
FIRST_WINS_LIMIT=100

# SECOND_KEY_LIMIT is the mirror image: unsatisfiable first, satisfiable
# second. Its case must fail against 100 — a switch to last-match semantics
# would make it pass.
SECOND_KEY_LIMIT=100
SECOND_KEY_LIMIT=1000000

# A duplicate hidden behind a comment is not a duplicate: comment lines are
# skipped, so only the live line is seen and the limit stays 1000000.
COMMENTED_OUT_LIMIT=1000000
# COMMENTED_OUT_LIMIT=100

# Whitespace around `=` is trimmed on both sides, so the spaced spelling below
# duplicates SPACED_LIMIT and the first, larger value is what resolves.
SPACED_LIMIT=1000000
SPACED_LIMIT = 100
