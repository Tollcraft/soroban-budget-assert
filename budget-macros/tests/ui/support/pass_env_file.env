# Fixture for budget-macros UI tests.
# Do not remove: `pass_env_file.rs` reads this file via the macro-generated
# env_file lookup. TINY_LIMIT is set large enough that the mock cost (999)
# stays well below it, isolating the "missing key" path from the
# "limit crossed" path during UI verification.
TINY_LIMIT=1000000

# Network-wide limits for percentage-limit tests.
# PCT_TEST_CPU_NETWORK is used by pass_percentage_limit.rs to verify that
# `pct = 25, of = env_file = "...", env = "PCT_TEST_CPU_NETWORK"` resolves
# to 25% of this value (2500). Mock cost of 2499 passes, 2501 fails.
PCT_TEST_CPU_NETWORK=10000
PCT_TEST_MEM_NETWORK=20000
