# Fixture for budget-macros UI tests.
# Do not remove: `pass_read_bytes_env_file_baseline.rs` reads this file through
# the macro-generated `env_file` lookup. The two limits are deliberately chosen
# so that the pass/fail verdict of each fixture case depends on BOTH the file's
# value and the baseline subtraction:
#
#   READ_BYTES_LOOSE_LIMIT = 500  — marginal 200 passes, marginal 900 fails
#   READ_BYTES_TIGHT_LIMIT = 100  — marginal 50 passes, raw 1050 would fail
#
# The tight value is what pins the ordering: a measurement of 1_050 against a
# limit of 100 can only pass if the 1_000 baseline is subtracted before the
# env-file limit is applied.
READ_BYTES_LOOSE_LIMIT=500
READ_BYTES_TIGHT_LIMIT=100
